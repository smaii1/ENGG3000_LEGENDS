{
  "name": "whack-a-mole",
  "version": "1.0.0",
  "description": "Whack-a-Mole desktop game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.example.whackamole",
    "productName": "Whack-a-Mole",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "assets/**/*",
      "sounds/**/*",
      "src/**/*",
      "node_modules/phaser/dist/phaser.min.js",
      "*.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "phaser": "^3.16.2"
  }
}
